#!/usr/bin/env bash
set -euo pipefail

install -d -m 0755 /opt/todo-app
cat >/opt/todo-app/bootstrap.sh <<'BOOTSTRAP_SCRIPT'
${bootstrap_script}
BOOTSTRAP_SCRIPT
chmod 0755 /opt/todo-app/bootstrap.sh

install -d -m 0750 /etc/todo-app
cat >/etc/todo-app/bootstrap.env <<'BOOTSTRAP_ENV'
APP_PORT=${app_port}
AWS_REGION=${aws_region}
BOOTSTRAP_CLOUDWATCH_LOG_GROUP=${cloudwatch_log_group_name}
CORS_ALLOWED_ORIGIN=${cors_allowed_origin}
COSIGN_CERTIFICATE_IDENTITY_REGEXP=${cosign_certificate_identity_regexp}
COSIGN_CERTIFICATE_OIDC_ISSUER=${cosign_certificate_oidc_issuer}
COSIGN_VERSION=${cosign_version}
DB_HOST=${db_host}
DB_NAME=${db_name}
DB_PORT=${db_port}
DB_SSLMODE=${db_sslmode}
DB_USER=${db_user}
DOMAIN_NAME=${domain_name}
FALLBACK_RELEASE_TAG=${fallback_release_tag}
GITHUB_REPOSITORY=${github_repository}
JWT_SECRET_SSM_PARAMETER=${jwt_secret_ssm_parameter_name}
OIDC_CLIENT_ID=${oidc_client_id}
OIDC_CLIENT_SECRET_SSM_PARAMETER=${oidc_client_secret_ssm_parameter_name}
OIDC_ISSUER_URL=${oidc_issuer_url}
OIDC_REDIRECT_URL=${oidc_redirect_url}
RELEASE_ARTIFACT_NAME=${release_artifact_name}
RELEASE_SIGNATURE_BUNDLE_NAME=${release_signature_bundle_name}
RELEASE_TAG_PARAMETER_NAME=${release_tag_parameter_name}
BOOTSTRAP_ENV
chmod 0640 /etc/todo-app/bootstrap.env

/opt/todo-app/bootstrap.sh
